<Window x:Class="FusionClient.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Fusion Client" Height="720" Width="1100" MinHeight="650" MinWidth="900"
 WindowStartupLocation="CenterScreen" Background="#0B0B12" Foreground="#F4F0FC">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#12101C">
   <StackPanel Margin="24">
    <TextBlock Text="FUSION" FontSize="29" FontWeight="Bold" Foreground="#C6A8FF" Margin="0,20,0,0"/>
    <TextBlock Text="CLIENT  •  WINDOWS" FontSize="10" Foreground="#817995" Margin="2,0,0,40"/>
    <Border Background="#211B30" CornerRadius="9" Padding="13"><TextBlock Text="⌂   Dashboard" FontSize="14"/></Border>
    <TextBlock Text="▣   Versionen" Margin="13,18,0,0" Foreground="#B9B1C8"/>
    <TextBlock Text="⚙   Einstellungen" Margin="13,18,0,0" Foreground="#B9B1C8"/>
    <TextBlock Text=" " />
    <TextBlock Text="FUSION CLIENT 1.0.0" Foreground="#615970" FontSize="9" Margin="0,280,0,0"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
   <StackPanel Margin="42,38,42,28">
    <TextBlock Text="Dein Minecraft." FontSize="31" FontWeight="Bold"/>
    <TextBlock Text="Dein Style. Dein Fusion Client." Foreground="#9A91AA" Margin="0,3,0,25"/>
    <Border Background="#171326" BorderBrush="#302747" BorderThickness="1" CornerRadius="16" Padding="25">
     <StackPanel>
      <TextBlock Text="FUSION CLIENT" FontSize="24" FontWeight="Bold" Foreground="#C8ADFF"/>
      <TextBlock Text="JAVA EDITION  •  WINDOWS" FontSize="10" Foreground="#8D829F" Margin="2,4,0,17"/>
      <TextBlock Text="Wähle deine Minecraft-Version und starte dein Spiel."/>
     </StackPanel>
    </Border>
    <Border Background="#12101C" CornerRadius="13" Padding="22" Margin="0,18,0,0">
     <StackPanel>
      <TextBlock Text="SPIELVERSION" Foreground="#AAA0BB" FontSize="10" FontWeight="Bold"/>
      <ComboBox x:Name="VersionBox" Height="38" Margin="0,8,0,17" Background="#211D30" Foreground="#171326"/>
      <TextBlock Text="MICROSOFT-KONTO" Foreground="#AAA0BB" FontSize="10" FontWeight="Bold"/>
      <DockPanel Margin="0,8,0,0">
       <Button x:Name="LoginButton" Content="Mit Microsoft anmelden" Click="LoginButton_Click"
        Background="#29213B" Foreground="White" BorderThickness="0" Padding="16,10" HorizontalAlignment="Left"/>
       <TextBlock x:Name="AccountLabel" Text="Nicht angemeldet" Foreground="#AAA0BB" VerticalAlignment="Center" Margin="14,0,0,0"/>
      </DockPanel>
      <TextBlock Text="RAM-Zuweisung (GB)" Foreground="#AAA0BB" FontSize="10" FontWeight="Bold" Margin="0,20,0,5"/>
      <DockPanel>
       <Slider x:Name="RamSlider" Minimum="2" Maximum="12" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" Width="230"/>
       <TextBlock x:Name="RamLabel" Text="4 GB" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>
     </StackPanel>
    </Border>
    <ProgressBar x:Name="Progress" Height="5" Margin="0,20,0,8" Visibility="Collapsed" IsIndeterminate="True"/>
    <DockPanel>
     <TextBlock x:Name="StatusLabel" Text="Bereit. Anmeldung und Spielstart werden eingerichtet." Foreground="#AAA0BB" VerticalAlignment="Center" TextWrapping="Wrap"/>
     <Button x:Name="PlayButton" Content="▶  SPIELEN" Click="PlayButton_Click" Background="#8255DC"
      Foreground="White" BorderThickness="0" Padding="27,13" FontWeight="Bold" DockPanel.Dock="Right"/>
    </DockPanel>
    <TextBlock Text="Fusion Client ist ein unabhängiges Community-Projekt und kein offizielles Mojang- oder Microsoft-Produkt."
     Foreground="#625B70" FontSize="9" Margin="0,26,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
