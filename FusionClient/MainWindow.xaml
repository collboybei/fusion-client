<Window x:Class="FusionClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fusion Client" Height="790" Width="1360"
        MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#09090D" Foreground="#F7F5FA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141419"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#96939F"/>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A5A2AE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F1FA"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="#25232D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#373440"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="82"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <Border Grid.Column="0" Background="#101015" BorderBrush="#24232B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="#6D39C7"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="F" FontSize="27" FontWeight="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="7,12,7,0">
                    <Border Background="#292333" CornerRadius="12" Padding="8,12" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Spielen" Style="{StaticResource NavText}" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,8,0,14">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="Instanzen" Style="{StaticResource NavText}"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,14">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="Einstellungen" Style="{StaticResource NavText}"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,14">
                        <TextBlock Text="&#xE789;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="Neuigkeiten" Style="{StaticResource NavText}"/>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,14">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource NavIcon}"/>
                        <TextBlock Text="Konto" Style="{StaticResource NavText}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="FUSION" Foreground="#77717F"
                           FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="62"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Fusion" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text=" Client" FontSize="23" Foreground="#BEB9C8" Margin="5,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="LoginButton" Content="Mit Microsoft anmelden"
                        Click="LoginButton_Click" Style="{StaticResource SmallButton}" Margin="0,0,12,0"/>
                <Border Grid.Column="2" Background="#1B1922" BorderBrush="#35313E"
                        BorderThickness="1" CornerRadius="18" Padding="13,7"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="AccountLabel" Text="Nicht angemeldet"
                               Foreground="#E8E4EE" FontSize="12" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="18,4,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="68"/>
                </Grid.RowDefinitions>

                <!-- Hero -->
                <Border Grid.Column="0" Grid.Row="0" CornerRadius="18"
                        BorderBrush="#30283D" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#17121F" Offset="0"/>
                                <GradientStop Color="#21102A" Offset="0.48"/>
                                <GradientStop Color="#10121C" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Ellipse Width="510" Height="510" Fill="#4A176E" Opacity="0.12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="360" Height="360" Fill="#A22C9C" Opacity="0.08"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,34,0,0">
                            <TextBlock Text="DEIN SPIEL. DEIN CLIENT." FontSize="11"
                                       Foreground="#C9A8F5" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="HeroName" Text="Fusion Client" FontSize="42"
                                       FontWeight="Black" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                            <TextBlock Text="Willkommen zurück!" FontSize="14"
                                       Foreground="#AAA2B4" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Decorative block-style mascot -->
                        <Grid Width="230" Height="300" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Margin="0,72,0,0">
                            <Rectangle Width="112" Height="90" Fill="#7B4CC6"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"/>
                            <Rectangle Width="88" Height="58" Fill="#E0A27C"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"/>
                            <Rectangle Width="20" Height="15" Fill="#24202B"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="79,45,0,0"/>
                            <Rectangle Width="20" Height="15" Fill="#24202B"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,45,79,0"/>
                            <Rectangle Width="112" Height="116" Fill="#A33EAE"
                                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,88,0,0"/>
                            <Rectangle Width="44" Height="112" Fill="#6E329F"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,95,0,0"/>
                            <Rectangle Width="44" Height="112" Fill="#C34C91"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,95,0,0"/>
                            <Rectangle Width="48" Height="88" Fill="#34233F"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="50,0,0,0"/>
                            <Rectangle Width="48" Height="88" Fill="#4D2B70"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,50,0"/>
                            <Border Width="30" Height="38" Background="#17131D" CornerRadius="5"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,112,0,0">
                                <TextBlock Text="F" Foreground="#D9B8FF" FontWeight="Black"
                                           FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Margin="0,0,0,28">
                            <TextBlock Text="MINECRAFT JAVA EDITION" Foreground="#B8AFC2"
                                       FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,9"/>
                            <ComboBox x:Name="VersionBox" Width="220" Height="34"
                                      HorizontalContentAlignment="Center"
                                      Background="#282331" Foreground="#17131D"
                                      Margin="0,0,0,10"/>
                            <Button x:Name="PlayButton" Content="▶   Spielen"
                                    Click="PlayButton_Click" Width="300" Height="64"
                                    FontSize="21" FontWeight="Bold" Foreground="White"
                                    BorderBrush="#8D67E5" BorderThickness="1"
                                    Cursor="Hand">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#477FC6" Offset="0"/>
                                        <GradientStop Color="#7046B8" Offset="1"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                            <TextBlock x:Name="StatusLabel" Text="Bereit zum Spielen"
                                       Foreground="#B9B1C4" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,9,0,0"/>
                            <ProgressBar x:Name="Progress" Height="4" Width="250"
                                         Margin="0,7,0,0" Visibility="Collapsed"
                                         IsIndeterminate="True"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right information rail -->
                <Grid Grid.Column="1" Grid.Row="0" Margin="14,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.1*"/>
                        <RowDefinition Height="0.9*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#141419" BorderBrush="#302D37"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="FREUNDE" FontSize="17" FontWeight="Bold"/>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Noch keine Freunde verbunden"
                                           Foreground="#8E8996" FontSize="12"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Freundesliste kommt später"
                                           Foreground="#686370" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#141419" BorderBrush="#302D37"
                            BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="NEUIGKEITEN" FontSize="17" FontWeight="Bold"/>
                                <TextBlock Text="FUSION" Foreground="#8F8799"
                                           FontSize="10" HorizontalAlignment="Right"
                                           DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Background="#281B38" CornerRadius="10" Padding="13" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="FUSION CLIENT" Foreground="#D5B6FF"
                                               FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="Dein Minecraft-Erlebnis." FontSize="18"
                                               FontWeight="Bold" TextWrapping="Wrap" Margin="0,7,0,4"/>
                                    <TextBlock Text="Ein eigener Launcher von Fusion GmbH."
                                               Foreground="#B7AFC1" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Weitere Neuigkeiten folgen."
                                       Foreground="#77717F" FontSize="10" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick play bar -->
                <Border Grid.Row="1" Grid.Column="0" Background="#17151D"
                        BorderBrush="#302D37" BorderThickness="1" CornerRadius="14"
                        Margin="0,12,0,0" Padding="15,8">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="QUICK PLAY" Foreground="#9C96A5"
                                   FontWeight="Bold" FontSize="11"
                                   VerticalAlignment="Center" Margin="2,0,20,0"/>
                        <TextBlock Text="Freunde-Server     •     PixelPlatz     •     Eigene Server"
                                   Foreground="#D0CBD7" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="#17151D"
                        BorderBrush="#302D37" BorderThickness="1" CornerRadius="14"
                        Margin="14,12,0,0" Padding="12,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RAM" Foreground="#A7A1AE" FontSize="10"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="RamSlider" Minimum="2" Maximum="12" Value="4"
                                TickFrequency="1" IsSnapToTickEnabled="True" Width="110"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="RamLabel" Text="4 GB" Foreground="White"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
