<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Fusion Client</AssemblyName>
    <RootNamespace>FusionClient</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <AssemblyTitle>Fusion Client</AssemblyTitle>
    <AssemblyProduct>Fusion Client</AssemblyProduct>
    <AssemblyCompany>Fusion GmbH</AssemblyCompany>
    <Company>Fusion GmbH</Company>
    <Authors>Fusion GmbH</Authors>
    <Description>Offizieller Minecraft Launcher von Fusion GmbH.</Description>
    <Copyright>Copyright © 2026 Fusion GmbH</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.4.0" />
  </ItemGroup>
</Project>
